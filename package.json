    "upload:release": "node ./scripts/upload-release-assets.js"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
