<Window x:Class="BlockHarbor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BlockHarbor - Native Minecraft Server Platform"
        Height="860" Width="1380"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Grid Background="{StaticResource BgDarkBrush}">
        <!-- Main Web Application Host -->
        <wv2:WebView2 Name="MainWebView" Visibility="Visible" />

        <!-- Startup / Loading Overlay -->
        <Grid Name="LoadingOverlay" Background="{StaticResource BgDarkBrush}" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- BlockHarbor Logo Graphic -->
                <Border Width="96" Height="96" CornerRadius="20" Background="#050810"
                        BorderBrush="#1e293b" BorderThickness="1.5"
                        HorizontalAlignment="Center" Margin="0,0,0,20" ClipToBounds="True">
                    <Image x:Name="SplashImage" Source="icon.png" Width="96" Height="96" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <!-- Brand Name -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="Block" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Harbor" FontSize="26" FontWeight="ExtraBold" Foreground="#38bdf8" />
                </StackPanel>

                <!-- Status Text -->
                <TextBlock Name="LoadingStatusText" Text="Initializing local Minecraft engine..."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />

                <!-- Progress Ring / Bar -->
                <ProgressBar Name="LoadingProgressBar" IsIndeterminate="True"
                             Width="220" Height="4"
                             Foreground="#38bdf8"
                             Background="{StaticResource BorderDarkBrush}"
                             BorderThickness="0" />

                <!-- Error Container -->
                <StackPanel Name="ErrorPanel" Visibility="Collapsed" Margin="0,20,0,0" Width="400">
                    <Border Background="#3f1212" BorderBrush="#7f1d1d" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Service Initialization Issue" FontWeight="Bold" Foreground="#fca5a5" Margin="0,0,0,4" />
                            <TextBlock Name="ErrorMessageText" Text="Could not establish connection to the local backend service."
                                       TextWrapping="Wrap" FontSize="12" Foreground="#fecaca" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Name="BtnViewLogs" Content="View Logs" Padding="10,4" Margin="0,0,8,0"
                                        Background="#27272a" Foreground="White" BorderThickness="0" Click="BtnViewLogs_Click" />
                                <Button Name="BtnRetry" Content="Retry" Padding="14,4"
                                        Background="{StaticResource EmeraldAccentBrush}" Foreground="White" BorderThickness="0" Click="BtnRetry_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
