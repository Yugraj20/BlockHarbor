<Application x:Class="BlockHarbor.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Modern Dark Theme Palette -->
        <Color x:Key="BgDarkColor">#0c1210</Color>
        <Color x:Key="SurfaceDarkColor">#141d1a</Color>
        <Color x:Key="BorderDarkColor">#22312b</Color>
        <Color x:Key="EmeraldAccentColor">#10b981</Color>
        <Color x:Key="EmeraldHoverColor">#059669</Color>
        <Color x:Key="TextPrimaryColor">#f4f4f5</Color>
        <Color x:Key="TextSecondaryColor">#a1a1aa</Color>

        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
        <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDarkColor}" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}" />
        <SolidColorBrush x:Key="EmeraldAccentBrush" Color="{StaticResource EmeraldAccentColor}" />
        <SolidColorBrush x:Key="EmeraldHoverBrush" Color="{StaticResource EmeraldHoverColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    </Application.Resources>
</Application>
